{
  "_readme": "Every form on the site is defined here. To change a form, edit its fields and commit. Field types: text, email, tel, url, number, select, textarea, checkbox, hidden. Add \"half\": true to put two fields side by side. A select takes \"options\" (a list) or \"options_from\": \"origins\" or \"currencies\". \"show_on\" decides which page group displays the form: \"contact\" is the Contact page, \"contribute\" is the section on the home page.",
  "settings": {
    "_readme": "provider \"cloudflare\" posts to the Pages Function at /api/contact (functions/api/contact.js), which emails info@brandmarkenya.com. Use \"web3forms\" with a key in config.json as a no-code alternative.",
    "provider": "web3forms",
    "subject_prefix": "Brandmark Atlas: ",
    "success": "Thank you. We received your message and will reply to the contact details you gave, if any.",
    "not_configured": "Sending is not switched on yet. Please message us on WhatsApp or email us instead.",
    "wait": "Please wait a few seconds before sending another message.",
    "consent_html": "I have read the <a href=\"privacy.html\" target=\"_blank\" rel=\"noopener\">Privacy Policy</a> and agree that Brandmark Systems Limited may use what I send to deal with my request.",
    "web3forms_endpoint": "https://api.web3forms.com/submit",
    "endpoint": "/api/contact"
  },
  "forms": {
    "contact": {
      "tab": "General enquiry",
      "show_on": [
