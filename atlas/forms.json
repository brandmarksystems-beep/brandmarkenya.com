            "A listing or price looks wrong",
            "Partnership or affiliate",
            "Media or press",
            "Something else"
          ]
        },
        {
          "name": "name",
          "label": "Your name",
          "type": "text",
          "required": true,
          "max": 100,
          "half": true
        },
        {
          "name": "email",
          "label": "Email",
          "type": "email",
          "required": true,
          "max": 160,
          "half": true
        },
        {
          "name": "phone",
          "label": "Phone or WhatsApp (optional)",
          "type": "tel",
          "max": 30
        },
        {
          "name": "message",
          "label": "Message",
          "type": "textarea",
          "required": true,
          "max": 2000
        }
      ]
